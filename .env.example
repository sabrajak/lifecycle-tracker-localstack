# Optional local overrides for docker compose (never commit .env):
#   cp .env.example .env
#
# Artifactory credentials are NOT stored here. Export them in your shell
# before `docker compose build` or `docker compose up`:
#
#   export ARTIFACTORY_USER=your-jfrog-username
#   export ARTIFACTORY_API_KEY=your-jfrog-api-key-or-token
#
# Optional: LocalStack data directory (default ./.localstack)
# LOCALSTACK_VOLUME_DIR=./.localstack

# ---------------------------------------------------------------------------
# app-lifecycle-tracking defaults (already set in docker-compose.yml)
# Override in .env only if you need to switch backends without editing compose.
# ---------------------------------------------------------------------------
# APP_LIFECYCLE_DB_TYPE=postgres          # postgres | dynamodb
# APP_LIFECYCLE_TRACKING_QUEUE_TYPE=kafka # kafka | sqs
# APP_LIFECYCLE_CALLBACK_THREAD_POOL_SIZE=5
